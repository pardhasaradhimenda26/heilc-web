# ── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.heilc.com

# ── Accounts (Supabase, free plan) ────────────────────────────────────
# Leave these empty and the site works exactly as before: no login, every
# form open. Fill them in to switch accounts on.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the daily retention job. Never prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
# Which sign-in buttons to show.
NEXT_PUBLIC_AUTH_PROVIDERS=google,facebook,email
# Phone OTP needs a paid SMS provider connected in Supabase. Keep "false" to stay free.
NEXT_PUBLIC_ENABLE_PHONE_LOGIN=false

# ── AI assistant + proposal generator ────────────────────────────────
# Groq free tier (no card): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Optional paid fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Email (Resend free tier: 3,000/month) ─────────────────────────────
RESEND_API_KEY=
CONTACT_RECEIVER_EMAIL=
# After verifying heilc.com in Resend, e.g. "HEILC <hello@heilc.com>".
CONTACT_FROM_EMAIL=

# ── Privacy (DPDP Act) ────────────────────────────────────────────────
# Inbox for data-protection questions and grievances (defaults to hello@heilc.com).
NEXT_PUBLIC_GRIEVANCE_EMAIL=

# ── Daily job (keep-alive + retention). Vercel sends it automatically. ─
CRON_SECRET=

# ── Search engine verification (meta tag values only) ────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
